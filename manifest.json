{
  "manifest_version": 3,
  "name": "阅读模式",
  "version": "1.0.0",
  "description": "清除页面干扰，提供沉浸式阅读体验",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "切换阅读模式 (Ctrl+Shift+R)"
  },
  "commands": {
    "toggle-reader-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "切换阅读模式"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["styles/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
